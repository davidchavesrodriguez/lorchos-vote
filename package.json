{
  "name": "lorchos-vote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:readiness && npm run test:preparation && npm run test:tokens && npm run test:voting-session && npm run test:credentials && npm run test:lifecycle && npm run test:public-voting-order && npm run test:public-voting-headers && npm run test:public-voting-transport && npm run test:public-voting && npm run test:results",
    "test:readiness": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test tests/election-readiness.test.mjs",
    "test:preparation": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test --test-concurrency=1 tests/election-preparation.integration.test.mts",
    "test:tokens": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test tests/voting-token.test.mjs",
    "test:voting-session": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test tests/voting-session.test.mjs",
    "test:credentials": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test --test-concurrency=1 tests/voting-credentials.integration.test.mts",
    "test:lifecycle": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test --test-concurrency=1 tests/election-lifecycle.integration.test.mts",
    "test:public-voting-order": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test tests/public-voting-order.test.mjs",
    "test:public-voting-headers": "node --experimental-strip-types --test tests/public-voting-headers.test.mjs",
    "test:public-voting-transport": "node --experimental-strip-types --test tests/public-voting-transport.test.mjs",
    "test:public-voting": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test --test-concurrency=1 tests/public-voting.integration.test.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:results": "node --experimental-strip-types --import ./tests/server-only-hook.mjs --test --test-concurrency=1 tests/election-result-calculation.test.mjs tests/admin-election-results.integration.test.mts tests/admin-read-authorization.test.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  }
}
